<Application
    x:Class="Vybe.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button">
                <Setter Property="Background" Value="#24FFFFFF" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="#55FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="#35FFFFFF" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="AutoSuggestBox">
                <Setter Property="Background" Value="#20FFFFFF" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="#35FFFFFF" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentBrush" Color="#9AA7FF" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#241F2B" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#A6A2B3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentBrush" Color="#9AA7FF" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#241F2B" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#A6A2B3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentBrush" Color="#5968D9" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#F0EFF7" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#666276" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
