<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vybe.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="&lt;3">

    <Grid x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <SolidColorBrush x:Key="GlassPanelBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="#7DD3FC" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7DD3FC" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7DD3FC" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#2F2C39" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#484453" />
            <Style TargetType="Button">
                <Setter Property="Background" Value="#24FFFFFF" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="#55FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="RailButton" TargetType="ToggleButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TransportButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>
            <Style x:Key="SlimSlider" TargetType="Slider">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="StepFrequency" Value="1" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
            </Style>
            <Style x:Key="ArtistLinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="PlaybackMetadataButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="PlaylistItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ LEFT RAIL ============ -->
        <Border x:Name="SidebarRail" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Background="{StaticResource GlassPanelBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,18,0,20" HorizontalAlignment="Center">
                    <Image x:Name="AppLogo" Width="42" Height="42" Stretch="UniformToFill" />
                    <TextBlock Text="&lt;3" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Center">
                        <ToggleButton x:Name="HomeNav" Style="{StaticResource RailButton}" Click="HomeNav_Click"
                                      ToolTipService.ToolTip="Home">
                            <FontIcon Glyph="&#xE80F;" FontSize="17" />
                        </ToggleButton>
                        <ToggleButton x:Name="LibraryNav" Style="{StaticResource RailButton}" Click="LibraryNav_Click"
                                      ToolTipService.ToolTip="Library">
                            <FontIcon Glyph="&#xE8F1;" FontSize="17" />
                        </ToggleButton>
                        <ToggleButton x:Name="EqualizerNav" Style="{StaticResource RailButton}" Click="EqualizerNav_Click"
                                      ToolTipService.ToolTip="Equalizer">
                            <FontIcon Glyph="&#xE992;" FontSize="17" />
                        </ToggleButton>
                        <Border Height="1" Width="28" Margin="0,10,0,6" Background="#44FFFFFF" />
                        <StackPanel x:Name="SidebarPlaylistsStack" HorizontalAlignment="Center" Spacing="2" />
                    </StackPanel>
                </ScrollViewer>

                <ToggleButton Grid.Row="2" x:Name="SettingsNav" Style="{StaticResource RailButton}"
                              Click="SettingsNav_Click" Margin="0,0,0,18"
                              ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="17" />
                </ToggleButton>
            </Grid>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="SearchHeader" Grid.Row="0" Margin="28,20,28,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" Text="" PlaceholderText=""
                                QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted"
                                MaxWidth="620" HorizontalAlignment="Left" />

                <DropDownButton Grid.Column="1" ToolTipService.ToolTip="Import">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Import files" Click="Import_Click" />
                            <MenuFlyoutItem Text="Import playlist link" Click="ImportPlaylist_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <Grid x:Name="ContentArea" Grid.Row="1" Margin="28,0,28,0">

                <!-- HOME / SEARCH RESULTS -->
                <Grid x:Name="HomePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="HomeHeading" Grid.Row="0" Text=""
                               FontSize="22" FontWeight="SemiBold" Margin="0,4,0,14" TextWrapping="Wrap" />

                    <ListView x:Name="ResultsList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="ResultsList_SelectionChanged"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="60" ColumnSpacing="14" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock Text="♫" FontSize="21" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                                            Click="AddTrackToPlaylist_Click" ToolTipService.ToolTip="Add to playlist">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    </Button>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Button Content="{Binding ArtistName}" Click="ArtistProfile_Click"
                                                Style="{StaticResource ArtistLinkButton}"
                                                ToolTipService.ToolTip="Open artist profile" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding DurationLabel}" FontSize="12"
                                               VerticalAlignment="Center" Width="46" TextAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- ARTIST PROFILE -->
                <Grid x:Name="ProfilePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,4,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ProfileHeading" Text="Artist" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProfileDescription" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Back to results" Click="ProfileBack_Click" />
                    </Grid>
                    <ListView x:Name="ProfileTracksList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="ProfileTracksList_SelectionChanged"
                              ItemContainerTransitions="{x:Null}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="58" ColumnSpacing="14" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock Text="&#x266B;" FontSize="21" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="10"
                                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding DurationLabel}" FontSize="12"
                                               VerticalAlignment="Center" Width="46" TextAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- LIBRARY -->
                <Grid x:Name="LibraryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="LibraryTracksPanel" Grid.Column="0" Margin="0,0,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Your library" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,14" />
                        <ListView x:Name="LibraryList" Grid.Row="1" SelectionMode="Single"
                                  SelectionChanged="LibraryList_SelectionChanged"
                                  ItemContainerTransitions="{x:Null}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="52" ColumnSpacing="14" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Grid>
                                                <TextBlock Text="♫" FontSize="19" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid x:Name="LibraryPlaylistsPanel" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,4,0,14">
                            <TextBlock Text="Playlists" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Click="CreatePlaylist_Click" Width="34" Height="34"
                                    Padding="0" CornerRadius="17" ToolTipService.ToolTip="New playlist">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                        </Grid>
                        <ListView x:Name="PlaylistList" Grid.Row="1" SelectionMode="Single"
                                  SelectionChanged="PlaylistList_SelectionChanged" ItemContainerTransitions="{x:Null}"
                                  ItemContainerStyle="{StaticResource PlaylistItemContainerStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="5" Background="Transparent" Loaded="PlaylistRow_Loaded">
                                    <Grid Height="62" ColumnSpacing="10" Padding="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="54" Height="54" CornerRadius="7" Background="#30303030">
                                            <Grid>
                                                <TextBlock Text="♫" Visibility="{Binding CoverPlaceholderVisibility}"
                                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Width="34" Height="34" Padding="0"
                                                Click="EditPlaylist_Click" ToolTipService.ToolTip="Edit playlist">
                                            <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="3" Width="34" Height="34" Padding="0"
                                                Click="DeletePlaylist_Click" ToolTipService.ToolTip="Delete playlist">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- PLAYLIST DETAIL -->
                <Grid x:Name="PlaylistDetailPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="22">
                            <Border x:Name="PlaylistDetailHeader" MinHeight="300" Padding="16" CornerRadius="14" Background="{StaticResource GlassPanelBrush}">
                            <Grid x:Name="PlaylistDetailHeaderGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="8,6,24,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Content="Back" Click="PlaylistBack_Click" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="PLAYLIST" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PlaylistDetailTitle" FontSize="32" FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="PlaylistDetailDescription" FontSize="15" TextWrapping="Wrap" />
                                        <TextBlock x:Name="PlaylistDetailUpdated" FontSize="12" />
                                    </StackPanel>
                                    <Grid x:Name="PlaylistDetailFooter" Grid.Row="2" Margin="0,18,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="0" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="PlaylistPlaybackControls" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                            <Button Width="64" Height="64" CornerRadius="32" Click="PlayPlaylist_Click"
                                                    ToolTipService.ToolTip="Play playlist">
                                                <FontIcon Glyph="&#xE768;" FontSize="24" />
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="PlaylistTrackCount" Text="0" FontSize="24" FontWeight="Bold" />
                                                <TextBlock Text="TRACKS" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="PlaylistDetailActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Spacing="8">
                                            <Button x:Name="DownloadPlaylistButton" Click="DownloadPlaylist_Click"
                                                    ToolTipService.ToolTip="Download all tracks in this playlist">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                                    <TextBlock Text="Download playlist" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="EditPlaylist_Click" ToolTipService.ToolTip="Edit playlist">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                                    <TextBlock Text="Edit playlist" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <Border x:Name="PlaylistDetailCoverBorder" Grid.Column="1" Width="280" Height="280" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image x:Name="PlaylistDetailCover" Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                            </Border>
                            <ListView x:Name="PlaylistTracksList" SelectionMode="Single"
                                      SelectionChanged="PlaylistTracksList_SelectionChanged" ItemContainerTransitions="{x:Null}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="58" ColumnSpacing="14" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Artwork}" Width="44" Height="44" Stretch="UniformToFill" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationLabel}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Width="36" Height="36" Padding="0"
                                                    Click="RemovePlaylistTrack_Click" ToolTipService.ToolTip="Remove from playlist">
                                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- EQUALIZER -->
                <Grid x:Name="EqualizerPage" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel Spacing="18">
                        <StackPanel>
                            <TextBlock Text="Equalizer" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <ComboBox x:Name="EqualizerPresetBox" Width="220" HorizontalAlignment="Left"
                                  SelectionChanged="EqualizerPresetBox_SelectionChanged">
                            <ComboBoxItem Content="Flat" />
                            <ComboBoxItem Content="Bass boost" />
                            <ComboBoxItem Content="Vocal" />
                            <ComboBoxItem Content="Treble" />
                            <ComboBoxItem Content="Rock" />
                        </ComboBox>
                        <Border Background="{StaticResource GlassPanelBrush}" CornerRadius="14" Padding="18">
                            <StackPanel x:Name="EqualizerBandsHost" Orientation="Horizontal" Spacing="12"
                                        HorizontalAlignment="Left" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="EqualizerStatus" Visibility="Collapsed" />
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12" />
                    <TabView x:Name="SettingsTabs" Grid.Row="1" IsAddTabButtonVisible="False" MinHeight="360">
                        <TabViewItem Header="General" IsClosable="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="14" Margin="8">
                                    <ToggleSwitch x:Name="StartWithWindowsToggle" Header="Start Risk when Windows starts"
                                                  OnContent="On" OffContent="Off"
                                                  Toggled="StartWithWindowsToggle_Toggled" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="Appearance" IsClosable="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10" Margin="8">
                                    <TextBlock Text="Choose a color theme" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="ThemeBox" Width="240" HorizontalAlignment="Left"
                                              SelectionChanged="ThemeBox_SelectionChanged">
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                        <ComboBoxItem Content="Midnight Blue" Tag="Midnight" />
                                        <ComboBoxItem Content="Ocean" Tag="Ocean" />
                                        <ComboBoxItem Content="Rose" Tag="Rose" />
                                        <ComboBoxItem Content="Forest" Tag="Forest" />
                                    </ComboBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="Playback" IsClosable="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" Margin="8">
                                    <ToggleSwitch x:Name="CrossfadeToggle" Header="Crossfade between songs"
                                                  OnContent="On" OffContent="Off" IsOn="False"
                                                  Toggled="CrossfadeToggle_Toggled" />
                                    <ToggleSwitch x:Name="AutoplaySimilarToggle" Header="Autoplay similar tracks when the queue ends"
                                                  OnContent="On" OffContent="Off" IsOn="True"
                                                  Toggled="AutoplaySimilarToggle_Toggled" />
                                    <ToggleSwitch x:Name="RememberVolumeToggle" Header="Remember volume between sessions"
                                                  OnContent="On" OffContent="Off"
                                                  Toggled="RememberVolumeToggle_Toggled" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="CrossfadeDurationSlider" Minimum="0.5" Maximum="12"
                                                Value="3" StepFrequency="0.5" IsEnabled="False"
                                                ValueChanged="CrossfadeDurationSlider_ValueChanged" />
                                        <TextBlock x:Name="CrossfadeDurationText" Grid.Column="1" Text="3.0 seconds"
                                                   VerticalAlignment="Center" MinWidth="78" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="Downloads" IsClosable="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10" Margin="8">
                                    <TextBlock Text="Download folder" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DownloadFolderBox" Grid.Column="0" IsReadOnly="True" />
                                        <Button Grid.Column="1" Content="Change" Click="ChangeFolder_Click" />
                                    </Grid>
                                    <TextBlock Text="Preferred download format" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                                    <ComboBox x:Name="PreferredDownloadFormatBox" Width="240" HorizontalAlignment="Left"
                                              SelectionChanged="PreferredDownloadFormatBox_SelectionChanged">
                                        <ComboBoxItem Content="Ask every time" Tag="ask" />
                                        <ComboBoxItem Content="MP3" Tag="mp3" />
                                        <ComboBoxItem Content="WAV" Tag="wav" />
                                    </ComboBox>
                                    <TextBlock Text="MP3 quality" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <ComboBox x:Name="Mp3BitrateBox" Width="240" HorizontalAlignment="Left"
                                              SelectionChanged="Mp3BitrateBox_SelectionChanged">
                                        <ComboBoxItem Content="128 kbps" Tag="128" />
                                        <ComboBoxItem Content="192 kbps" Tag="192" />
                                        <ComboBoxItem Content="256 kbps" Tag="256" />
                                        <ComboBoxItem Content="320 kbps" Tag="320" />
                                    </ComboBox>
                                    <ToggleSwitch x:Name="OrganizeDownloadsToggle" Header="Organize downloads into artist folders"
                                                  OnContent="On" OffContent="Off"
                                                  Toggled="OrganizeDownloadsToggle_Toggled" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                        <TabViewItem Header="Discord" IsClosable="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10" Margin="8">
                                    <ToggleSwitch x:Name="DiscordActivityToggle" Header="Show what I’m listening to on Discord"
                                                  OnContent="On" OffContent="Off" IsOn="True"
                                                  Toggled="DiscordActivityToggle_Toggled" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ConnectDiscordButton" Content="Connect to Discord" Click="AuthorizeDiscord_Click" />
                                        <Button x:Name="DisconnectDiscordButton" Content="Disconnect from Discord"
                                                Click="DisconnectDiscord_Click" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock x:Name="DiscordActivityStatus" Text="Discord activity is off."
                                               TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>
                    </TabView>
                    <Button Grid.Row="2" Content="Save settings" Click="SaveSettings_Click"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                </Grid>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" Visibility="Collapsed" />
        </Grid>

        <!-- ============ PLAYER BAR ============ -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource GlassPanelBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <Grid x:Name="PlayerLayout" Grid.Column="1" Padding="24,14" ColumnSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Now playing -->
                <Grid x:Name="NowPlayingPanel" Grid.Column="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NowArtworkButton" Grid.Column="0" Width="52" Height="52"
                            Style="{StaticResource PlaybackMetadataButton}" Click="NowTrack_Click"
                            ToolTipService.ToolTip="Add this song to a playlist">
                        <Grid>
                            <TextBlock Text="♫" FontSize="23" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image x:Name="NowArtwork" Stretch="UniformToFill" IsHitTestVisible="False" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource PlaybackMetadataButton}" Click="NowTrack_Click"
                                ToolTipService.ToolTip="Add this song to a playlist">
                            <TextBlock x:Name="NowTitle" Text="Nothing playing" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button x:Name="NowArtistButton" Content="" Click="NowArtist_Click"
                                Style="{StaticResource ArtistLinkButton}" ToolTipService.ToolTip="Open artist profile"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- Transport + seek -->
                <StackPanel x:Name="TransportPanel" Grid.Column="1" Spacing="4" Width="380">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <Button x:Name="ShuffleButton" Style="{StaticResource TransportButton}" Click="ShuffleButton_Click"
                                ToolTipService.ToolTip="Shuffle off">
                            <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="15" />
                        </Button>
                        <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Click="Previous_Click"
                                ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xE892;" FontSize="15" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Click="Play_Click"
                                Width="46" Height="46" CornerRadius="23"
                                Background="#38FFFFFF"
                                ToolTipService.ToolTip="Play / Pause">
                            <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="17"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Click="Next_Click"
                                ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xE893;" FontSize="15" />
                        </Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource TransportButton}" Click="RepeatButton_Click"
                                ToolTipService.ToolTip="Repeat off">
                            <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="15" />
                        </Button>
                <Button x:Name="FavoriteButton" Style="{StaticResource TransportButton}"
                                Click="FavoriteCurrent_Click" ToolTipService.ToolTip="Add to favorites">
                            <FontIcon x:Name="FavoriteIcon" Glyph="&#xEB51;" FontSize="15" />
                        </Button>
                        <Button x:Name="AddToPlaylistButton" Style="{StaticResource TransportButton}"
                                Click="AddCurrentToPlaylist_Click" ToolTipService.ToolTip="Add to playlist">
                            <FontIcon Glyph="&#xE710;" FontSize="15" />
                        </Button>
                        <Button x:Name="DownloadButton" Style="{StaticResource TransportButton}" Click="Download_Click"
                                ToolTipService.ToolTip="Download this track">
                            <FontIcon Glyph="&#xE896;" FontSize="15" />
                        </Button>
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Grid.Column="0" Text="0:00" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource SlimSlider}"
                                Minimum="0" Maximum="100" Value="0"
                                ValueChanged="SeekSlider_ValueChanged"
                                PointerPressed="SeekSlider_PointerPressed"
                                PointerReleased="SeekSlider_PointerReleased"
                                PointerCaptureLost="SeekSlider_PointerReleased" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Volume -->
                <StackPanel x:Name="VolumePanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="MuteButton" Style="{StaticResource TransportButton}" Width="34" Height="34"
                            Click="Mute_Click" ToolTipService.ToolTip="Mute">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="15" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Style="{StaticResource SlimSlider}"
                            Minimum="0" Maximum="100" Value="75" Width="110"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>


